{# templates/admin/etablissement/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Gestion des établissements - SchoolPrepar Admin{% endblock %}
{% block page_title %}Gestion des établissements{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des établissements</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Ville</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for etablissement in etablissements %}
                        <tr>
                            <td>{{ etablissement.id }}</td>
                            <td>{{ etablissement.nom }}</td>
                            <td>{{ etablissement.ville }}</td>
                            <td>{{ etablissement.description }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Retour au dashboard
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}