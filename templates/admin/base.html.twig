{# templates/admin/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titre %}SchoolPrepar Admin{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('admin/plugins/fontawesome-free/css/all.min.css') }}">
    <link rel="stylesheet" href="{{ asset('admin/dist/css/adminlte.min.css') }}">
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">

    {# Navbar #}
    {% block nav %}
        {% include 'admin/partials/nav.html.twig' %}
    {% endblock %}

    {# Sidebar #}
    {% block aside %}
        {% include 'admin/partials/aside.html.twig' %}
    {% endblock %}

    {# Content Wrapper #}
    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-12">
                        <h1 class="m-0">{% block page_title %}Dashboard{% endblock %}</h1>
                    </div>
                </div>
            </div>
        </div>

        <div class="content">
            <div class="container-fluid">
                {% block contenuPrincipal %}{% endblock %}
            </div>
        </div>
    </div>

    {# Footer #}
    {% block footer %}
        {% include 'admin/partials/footer.html.twig' %}
    {% endblock %}

</div>

<script src="{{ asset('admin/plugins/jquery/jquery.min.js') }}"></script>
<script src="{{ asset('admin/plugins/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
<script src="{{ asset('admin/dist/js/adminlte.min.js') }}"></script>

{% block javascripts %}{% endblock %}

</body>
</html>