{# templates/admin/dashboard.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Dashboard - SchoolPrepar Admin{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-lg-6 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>{{ stats.filieres }}</h3>
                <p>Filières</p>
            </div>
            <div class="icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <a href="{{ path('admin_filiere_index') }}" class="small-box-footer">
                Gérer les filières <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-6 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>{{ stats.etablissements }}</h3>
                <p>Établissements</p>
            </div>
            <div class="icon">
                <i class="fas fa-university"></i>
            </div>
            <a href="{{ path('admin_etablissement_index') }}" class="small-box-footer">
                Gérer les établissements <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Filières récentes</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Génie Logiciel</td>
                            <td>Formation en développement logiciel</td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Web et Internet Mobile</td>
                            <td>Formation en développement web et mobile</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Réseaux et Télécommunications</td>
                            <td>Formation en réseaux informatiques</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <a href="{{ path('admin_filiere_index') }}" class="btn btn-primary btn-sm">
                    Voir toutes les filières
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}