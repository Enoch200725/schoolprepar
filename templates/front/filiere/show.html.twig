{# templates/front/filiere/show.html.twig #}
{% extends 'front/base.html.twig' %}

{% block titre %}{{ filiere.nom }} - SchoolPrepar{% endblock %}

{% block contenuPrincipal %}
<section class="ab_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-3">
                <a href="{{ path('filiere_index') }}" class="btn_one">
                    &larr; Retour aux filières
                </a>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 col-sm-12">
                <div class="ab_img">
                    <img src="{{ asset('front/img/filieres/' ~ filiere.image) }}" class="img-fluid" alt="{{ filiere.nom }}" />
                </div>
            </div>
            <div class="col-lg-6 col-sm-12">
                <div class="ab_content">
                    <h2>{{ filiere.nom }}</h2>
                    <p>{{ filiere.description }}</p>
                    <ul>
                        <li><span class="ti-check"></span> Formation de qualité</li>
                        <li><span class="ti-check"></span> Enseignants expérimentés</li>
                        <li><span class="ti-check"></span> Débouchés professionnels</li>
                    </ul>
                    <a class="btn_one" href="{{ path('etablissement_index') }}">
                        Voir les établissements <i class="ti-arrow-top-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}