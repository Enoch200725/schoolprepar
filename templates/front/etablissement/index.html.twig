{# templates/front/etablissement/index.html.twig #}
{% extends 'front/base.html.twig' %}

{% block titre %}Liste des établissements - SchoolPrepar{% endblock %}

{% block contenuPrincipal %}
<section class="home_course section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Les Établissements</h2>
            <p>Découvrez tous les établissements partenaires de SchoolPrepar</p>
        </div>
        <div class="row mt-4">
            {% for etablissement in etablissements %}
            <div class="col-lg-4 col-sm-6 col-xs-12 mb-4">
                <div class="card h-100">
                    <img src="{{ asset('front/img/etablissements/' ~ etablissement.nom ~ '.jpg') }}" class="card-img-top" alt="{{ etablissement.nom }}" style="height: 200px; object-fit: cover;"
                         onerror="this.src='{{ asset('front/img/about1.png') }}'" />
                    <div class="card-body">
                        <h4 class="card-title">{{ etablissement.nom }}</h4>
                        <p class="card-text"><span class="ti-location-pin"></span> {{ etablissement.ville }}</p>
                        <p class="card-text">{{ etablissement.adresse }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}