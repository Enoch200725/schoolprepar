{# templates/etudiant/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Liste des étudiants - Admin{% endblock %}
{% block page_title %}Gestion des étudiants{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des étudiants</h3>
                <div class="card-tools">
                    <a href="{{ path('app_etudiant_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Ajouter un étudiant
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Age</th>
                            <th>Email</th>
                            <th>Filière</th>
                            <th>Établissement</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for etudiant in etudiants %}
                        <tr>
                            <td>{{ etudiant.id }}</td>
                            <td>{{ etudiant.nom }}</td>
                            <td>{{ etudiant.prenom }}</td>
                            <td>{{ etudiant.age }}</td>
                            <td>{{ etudiant.email }}</td>
                            <td>{{ etudiant.filiere.nom }}</td>
                            <td>{{ etudiant.etablissement.nom }}</td>
                            <td>
                                <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center">Aucun étudiant trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}