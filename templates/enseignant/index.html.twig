{# templates/enseignant/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Liste des enseignants - Admin{% endblock %}
{% block page_title %}Gestion des enseignants{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des enseignants</h3>
                <div class="card-tools">
                    <a href="{{ path('app_enseignant_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Ajouter un enseignant
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Cours</th>
                            <th>Code</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for enseignant in enseignants %}
                        <tr>
                            <td>{{ enseignant.id }}</td>
                            <td>{{ enseignant.nom }}</td>
                            <td>{{ enseignant.prenom }}</td>
                            <td>{{ enseignant.cours }}</td>
                            <td>{{ enseignant.code }}</td>
                            <td>
                                <a href="{{ path('app_enseignant_show', {'id': enseignant.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_enseignant_edit', {'id': enseignant.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_enseignant_delete', {'id': enseignant.id}) }}"
                                      style="display:inline-block"
                                      onsubmit="return confirm('Voulez-vous vraiment supprimer cet enseignant ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ enseignant.id) }}">
                                    <button class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucun enseignant trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}