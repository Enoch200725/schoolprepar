{# templates/filiere/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Détail filière - Admin{% endblock %}
{% block page_title %}Détail de la filière{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informations de la filière</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>ID</th>
                        <td>{{ filiere.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ filiere.nom }}</td>
                    </tr>
                    <tr>
                        <th>Code</th>
                        <td>{{ filiere.code }}</td>
                    </tr>
                    <tr>
                        <th>Crédit</th>
                        <td>{{ filiere.credit }}</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_filiere_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_filiere_edit', {'id': filiere.id}) }}" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Modifier
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}