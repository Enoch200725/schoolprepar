{# templates/filiere/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Liste des filières - Admin{% endblock %}
{% block page_title %}Gestion des filières{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des filières</h3>
                <div class="card-tools">
                    <a href="{{ path('app_filiere_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Ajouter une filière
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Code</th>
                            <th>Crédit</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for filiere in filieres %}
                        <tr>
                            <td>{{ filiere.id }}</td>
                            <td>{{ filiere.nom }}</td>
                            <td>{{ filiere.code }}</td>
                            <td>{{ filiere.credit }}</td>
                            <td>
                                <a href="{{ path('app_filiere_show', {'id': filiere.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_filiere_edit', {'id': filiere.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_filiere_delete', {'id': filiere.id}) }}"
                                      style="display:inline-block"
                                      onsubmit="return confirm('Voulez-vous vraiment supprimer cette filière ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ filiere.id) }}">
                                    <button class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucune filière trouvée</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}