{# templates/etablissement/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Liste des établissements - Admin{% endblock %}
{% block page_title %}Gestion des établissements{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des établissements</h3>
                <div class="card-tools">
                    <a href="{{ path('app_etablissement_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Ajouter un établissement
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Ville</th>
                            <th>Adresse</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for etablissement in etablissements %}
                        <tr>
                            <td>{{ etablissement.id }}</td>
                            <td>{{ etablissement.nom }}</td>
                            <td>{{ etablissement.ville }}</td>
                            <td>{{ etablissement.adresse }}</td>
                            <td>
                                <a href="{{ path('app_etablissement_show', {'id': etablissement.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_etablissement_edit', {'id': etablissement.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucun établissement trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}