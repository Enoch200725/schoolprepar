{# templates/registration/register.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inscription - Custom Auth</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Créer un compte</h4>
                    <small>Custom Authenticator Demo</small>
                </div>
                <div class="card-body p-4">

                    {{ form_start(registrationForm) }}

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nom complet</label>
                            {{ form_widget(registrationForm.nom, {
                                'attr': {'class': 'form-control', 'placeholder': 'Votre nom complet'}
                            }) }}
                            {% if registrationForm.nom.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in registrationForm.nom.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Adresse email</label>
                            {{ form_widget(registrationForm.email, {
                                'attr': {'class': 'form-control', 'placeholder': 'email@exemple.com'}
                            }) }}
                            {% if registrationForm.email.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in registrationForm.email.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mot de passe</label>
                            {{ form_widget(registrationForm.plainPassword, {
                                'attr': {'class': 'form-control', 'placeholder': 'Minimum 6 caractères'}
                            }) }}
                            {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                                <div class="text-danger mt-1">
                                    {% for error in registrationForm.plainPassword.vars.errors %}
                                        <small>{{ error.message }}</small>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark">
                                Créer mon compte
                            </button>
                        </div>

                    {{ form_end(registrationForm) }}

                </div>
                <div class="card-footer text-center">
                    <a href="{{ path('app_login') }}">Déjà un compte ? Se connecter</a>
                    <br>
                    <a href="{{ path('app_home') }}">Retour à l'accueil</a>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>