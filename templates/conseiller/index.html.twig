{# templates/conseiller/index.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Liste des conseillers - Admin{% endblock %}
{% block page_title %}Gestion des conseillers{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Liste des conseillers</h3>
                <div class="card-tools">
                    <a href="{{ path('app_conseiller_new') }}" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Ajouter un conseiller
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Age</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for conseiller in conseillers %}
                        <tr>
                            <td>{{ conseiller.id }}</td>
                            <td>{{ conseiller.nom }}</td>
                            <td>{{ conseiller.age }}</td>
                            <td>{{ conseiller.role }}</td>
                            <td>
                                <a href="{{ path('app_conseiller_show', {'id': conseiller.id}) }}" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_conseiller_edit', {'id': conseiller.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('app_conseiller_delete', {'id': conseiller.id}) }}"
                                      style="display:inline-block"
                                      onsubmit="return confirm('Voulez-vous vraiment supprimer ce conseiller ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ conseiller.id) }}">
                                    <button class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucun conseiller trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}