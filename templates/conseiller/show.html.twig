{# templates/conseiller/show.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block titre %}Détail conseiller - Admin{% endblock %}
{% block page_title %}Détail du conseiller{% endblock %}

{% block contenuPrincipal %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Informations du conseiller</h3>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>ID</th>
                        <td>{{ conseiller.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ conseiller.nom }}</td>
                    </tr>
                    <tr>
                        <th>Age</th>
                        <td>{{ conseiller.age }}</td>
                    </tr>
                    <tr>
                        <th>Role</th>
                        <td>{{ conseiller.role }}</td>
                    </tr>
                </table>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_conseiller_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_conseiller_edit', {'id': conseiller.id}) }}" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Modifier
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}