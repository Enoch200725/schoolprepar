{# templates/home/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Custom Authenticator - SchoolPrepar</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Custom Auth Demo</a>
        <div class="d-flex">
            {% if app.user %}
                <span class="navbar-text me-3 text-white">
                    Bonjour, <b>{{ app.user.nom }}</b>
                </span>
                <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                    Déconnexion
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm me-2">
                    Connexion
                </a>
                <a href="{{ path('app_register') }}" class="btn btn-light btn-sm">
                    Inscription
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<div class="container mt-5">
    {% if app.user %}
        <div class="card shadow p-4 text-center">
            <h1 class="mb-3">🎉 Bienvenue, {{ app.user.nom }} !</h1>
            <p class="lead">Vous êtes connecté avec l'email : <b>{{ app.user.email }}</b></p>
            <p>Vos rôles : <b>{{ app.user.roles|join(', ') }}</b></p>
            <hr>
            <p class="text-muted">
                Cette application démontre l'utilisation du <b>Custom Authenticator</b> de Symfony.
            </p>
            <a href="{{ path('app_logout') }}" class="btn btn-danger mt-3">Se déconnecter</a>
        </div>
    {% else %}
        <div class="card shadow p-4 text-center">
            <h1 class="mb-3">Custom Authenticator Demo</h1>
            <p class="lead">Démonstration du système d'authentification personnalisé avec Symfony 7</p>
            <hr>
            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>Vous avez un compte ?</h4>
                        <p>Connectez-vous avec votre email et mot de passe.</p>
                        <a href="{{ path('app_login') }}" class="btn btn-primary">Se connecter</a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-3">
                        <h4>Nouveau sur le site ?</h4>
                        <p>Créez un compte pour accéder à l'application.</p>
                        <a href="{{ path('app_register') }}" class="btn btn-success">S'inscrire</a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>